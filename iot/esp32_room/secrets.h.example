#pragma once
// Copy this file to `secrets.h` and fill in your own values.
// `secrets.h` is git-ignored so your credentials never get committed.
#define SECRET_WIFI_SSID "YourWiFiName"      // must be 2.4 GHz — ESP32 can't join 5 GHz
#define SECRET_WIFI_PASS "YourWiFiPassword"
#define SECRET_BROKER_IP "192.168.1.100"     // your Mac/host LAN IP running Mosquitto
