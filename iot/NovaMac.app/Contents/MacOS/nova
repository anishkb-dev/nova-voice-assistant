#!/bin/zsh
# NovaMac.app: launches the Mac's Nova as its own app, so macOS ties the mic/camera permission to "Nova"
# instead of Terminal. Started by launchd (com.nova.mac), which also brings it back after a crash or a
# deliberate self-restart (exit 3 = mic switch). Cleanup fix 5, 2026-11-17.
export PATH=/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
cd $HOME/anish-ai/app
exec /opt/homebrew/bin/python3.14 nova_app.py >> $HOME/anish-ai/app/nova.log 2>&1
